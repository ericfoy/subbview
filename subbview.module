<?php

/**
 * Implements hook_views_api().
 */
function subbview_views_api() {
  return array(
    'api' => '3.0',
    'path' => backdrop_get_path('module', 'subbview') . '/views',
  );
}

/**
 * Implements hook_autoload_info().
 */
 
function subbview_autoload_info() {
  // Map class → file. Prevents silent misses if Views doesn't include the file.
  return array(
    'views_plugin_style_subbview_table' => 'views/views_plugin_style_subbview_table.inc',    
  );
}


function subbview_library_info() {
  $base = backdrop_get_path('module', 'subbview');
  return array(
    'subbview' => array(
      'title' => 'Subbview UI',
      'version' => '1.x',
      'js'  => array($base . '/js/subbview.js' => array()),
      'css' => array($base . '/css/subbview.css' => array('type' => 'file', 'media' => 'all')),
    ),
  );
}


/**
 * Load assets only when our style is in use.
 */

function subbview_views_pre_render(&$view) {
  if (!empty($view->style_plugin) && ($view->style_plugin instanceof views_plugin_style_subbview_table)) {
    backdrop_add_library('subbview', 'subbview');
  }
}


